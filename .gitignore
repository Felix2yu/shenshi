# 构建产物
/bin/
/internal/web/dist/*
# 只留一个 .gitkeep：让没跑过 scripts/build.sh 的机器上 //go:embed all:dist 也能编译
!/internal/web/dist/.gitkeep
/web/dist/

# 依赖
/web/node_modules/
# 统一 pnpm：其他包管理器的锁文件不入库。双锁并存会让「按 lockfile 猜包管理器」猜错，
# 现在 CI 只读 packageManager 声明，但残留的锁文件仍然误导本地操作。
package-lock.json
yarn.lock
bun.lock
bun.lockb

# 运行时数据（本地数据库，不应入库）
/data/
*.db
*.db-wal
*.db-shm

# 部署时的本地配置：含访问口令，绝不能入库
.env

# WorkBuddy 工作区数据（本地工作记忆与日志，属个人环境，不入库）
.workbuddy/

# 杂项
.DS_Store
*.log

# 测试覆盖率产物（CI 生成后上传 Codecov，不入库）
coverage.out
coverage.html

# 图标生成用的字体源文件（12MB，只在本机跑 gen-icons.mjs / gen-icon-svg.py 时用，不入库；
# 网页用的单子集 public/fonts/shenshi-lishu.woff2 已入库）
/web/scripts/fonts/

# 本机程序坞图标：由 scripts/make-dock-icon.py 从 bundle 导出（310KB），
# 每人机器上重跑一次即可，源素材都在 web/public/icons 里，入库只会变成二进制噪声
/shenshi-dock.icns

# ---- 编辑器 / IDE 本地状态（不进版本库）----
.idea/
.vscode/
.vscode-test/
.history/
.fleet/
*.iml
*.swp
*.swo
*~

# ---- 系统垃圾文件（macOS / Windows / Linux 都会生成）----
.DS_Store
.DS_Store?
._*
.Spotlight-V100/
.Trashes/
.fseventsd/
.AppleDouble
.LSOverride
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/
*.lnk
*.tmp
*.temp
*.bak
*.orig
*.rej
*.pid

# ---- 通用本地缓存 / 测试产物（各仓再按技术栈补充）----
.cache/
.tmp/
.pnpm-store/
*.log
*.test
*.tsbuildinfo
.eslintcache
.stylelintcache
*.o
*.lo
*.la
*.a
*.so
*.dylib
*.dll
*.exe
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ---- 密钥 / 签名文件（绝不入库）----
.env
.env.local
.env.*.local
secrets/
*.p8
*.p12
*.pfx
*.jks
*.keystore
*.mobileprovision
*.provisionprofile

# ---- Swift / Xcode 本地状态 ----
.build/
.swiftpm/
DerivedData/
xcuserdata/
*.xcuserstate

# ---- AI Agent 生成目录（不进版本库，本地保留）----
# 各家 AI 编程工具落盘的会话记忆、规则缓存与索引。规则是目录级：
# 想共享的项目级配置请放 docs/ 或仓库根具名单文件，不要只忽略子目录。
.workbuddy/
.trae/
.trea/
.qoder/
.opencode/
.cursor/
.claude/
.codex/
.gemini/
.continue/
.windsurf/
.aider*
.zcode/
.mimocode/
.codebuddy/
.roo/
.cline/
.clinerules/
.kilocode/
.kilocodemodes
.kiro/
.junie/
.amazonq/
.spec-gen/
.openlore/
.bmad/
_bmad/
_bmad-output/
.sourcegraph/
.devin/
.factory/
.firebender/

