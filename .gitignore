# 构建产物
/bin/
/server/dist/
/web/dist/

# 依赖
/web/node_modules/

# 运行时数据（本地数据库，不应入库）
/data/
*.db
*.db-wal
*.db-shm

# 部署时的本地配置：含访问口令，绝不能入库
.env

# WorkBuddy 工作区数据（本地工作记忆与日志，属个人环境，不入库）
.workbuddy/

# 杂项
.DS_Store
*.log

# 测试覆盖率产物（CI 生成后上传 Codecov，不入库）
coverage.out
coverage.html

# 图标生成用的字体源文件（12MB，只在本机跑 gen-icons.mjs / gen-icon-svg.py 时用，不入库；
# 网页用的单子集 public/fonts/shenshi-lishu.woff2 已入库）
/web/scripts/fonts/
