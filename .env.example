# 复制为 .env 后按需修改：cp .env.example .env
#
# 访问口令：公网部署必须设置。生成方式（任选其一）：
#   openssl rand -base64 24
#   head -c 24 /dev/urandom | base64
# 留空表示不启用鉴权，只适合完全可信的内网。
SHENSHI_TOKEN=

# 时区：决定「今天」「逾期」「习惯打卡」算在哪一天，务必与使用者一致。
TZ=Asia/Shanghai

# 镜像 tag：默认 latest（跟随 main 的最新构建）。
# 想钉住版本或回滚，填对应的 commit sha —— CI 每次构建都会打上这个 tag。
# SHENSHI_TAG=
